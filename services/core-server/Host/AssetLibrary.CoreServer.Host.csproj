<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <AssemblyName>AssetLibrary.CoreServer.Host</AssemblyName>
    <RootNamespace>AssetLibrary.CoreServer.Hosting</RootNamespace>
    <Description>Single cross-platform host wrapper for the AssetLibrary modular core server.</Description>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssetLibrarySourceRevision Condition="'$(SourceRevisionId)' != ''">$(SourceRevisionId)</AssetLibrarySourceRevision>
    <AssetLibrarySourceRevision Condition="'$(AssetLibrarySourceRevision)' == ''">unissued</AssetLibrarySourceRevision>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <ProjectReference Include="..\AssetLibrary.CoreServer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="AssetLibrary.SourceRevision" Value="$(AssetLibrarySourceRevision)" />
  </ItemGroup>
</Project>
