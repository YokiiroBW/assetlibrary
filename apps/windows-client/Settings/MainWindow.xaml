<Window x:Class="AssetLibrary.Windows.Settings.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="资产库 · 连接设置">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="20" Padding="32" MaxWidth="640" HorizontalAlignment="Stretch">
      <StackPanel Spacing="8">
        <TextBlock Text="连接资产库" Style="{ThemeResource TitleTextBlockStyle}" TextWrapping="Wrap" />
        <TextBlock Text="在此登录 NAS，随后从资源管理器左侧的“资产库”浏览。" TextWrapping="Wrap"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
      </StackPanel>
      <InfoBar x:Name="StatusBar" IsOpen="True" IsClosable="False" Severity="Informational"
          Title="正在读取连接状态" Message="请稍候。" AutomationProperties.LiveSetting="Polite" />
      <StackPanel Spacing="16">
        <TextBox x:Name="OriginBox" Header="NAS 地址（HTTPS）" PlaceholderText="https://nas.example.com:5443"
            MaxLength="2048" InputScope="Url" AutomationProperties.Name="NAS HTTPS 地址" />
        <TextBox x:Name="CertificateBox" Header="证书 SHA-256 指纹（可选）" MaxLength="256"
            PlaceholderText="默认使用 Windows 信任的证书" AutomationProperties.Name="证书 SHA-256 指纹" />
        <TextBlock Text="自签证书请填写管理员提供的完整指纹；仍会验证主机名和有效期。" TextWrapping="Wrap"
            Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <TextBox x:Name="AccountBox" Header="账号" MaxLength="256" AutomationProperties.Name="账号" />
        <PasswordBox x:Name="PasswordBox" Header="密码" MaxLength="4096" AutomationProperties.Name="密码" />
        <CheckBox x:Name="RememberBox" Content="在此 Windows 账号下记住登录" IsChecked="False" />
        <TextBlock Text="记住登录使用 Windows 用户加密保护；退出登录会删除保存的凭据。" TextWrapping="Wrap"
            Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="12">
        <Button x:Name="ConnectButton" Content="连接并登录" Click="ConnectClick" Style="{ThemeResource AccentButtonStyle}" />
        <Button x:Name="DisconnectButton" Content="退出登录" Click="DisconnectClick" />
        <ProgressRing x:Name="BusyRing" IsActive="False" Width="28" Height="28" AutomationProperties.Name="正在连接" />
      </StackPanel>
      <TextBlock Text="浏览入口位于资源管理器。关闭此窗口后，后台连接继续运行。" TextWrapping="Wrap"
          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </StackPanel>
  </ScrollViewer>
</Window>
