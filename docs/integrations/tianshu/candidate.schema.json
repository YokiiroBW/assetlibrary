{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tianshu:candidate:asset-review:0.1.0",
  "title": "TS-060 review-only proposal; not a released wire contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "owner", "report_id", "revision", "request_id", "library_id", "observed_at", "source_revision", "analysis_state", "unavailable_reason", "execution_available", "entries", "candidates"],
  "properties": {
    "version": {"const": "0.1.0-candidate"},
    "owner": {"const": "assetlibrary"},
    "report_id": {"$ref": "#/$defs/id"},
    "revision": {"type": "integer", "minimum": 1},
    "request_id": {"$ref": "#/$defs/id"},
    "library_id": {"type": "string", "format": "uuid"},
    "observed_at": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"},
    "source_revision": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
    "analysis_state": {"enum": ["candidates_only", "unavailable"]},
    "unavailable_reason": {"enum": [null, "not_implemented", "source_unavailable", "permission_unavailable", "source_changed"]},
    "execution_available": {"const": false},
    "entries": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/entry"}},
    "candidates": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/candidate"}}
  },
  "allOf": [{
    "if": {"properties": {"analysis_state": {"const": "unavailable"}}},
    "then": {"properties": {"unavailable_reason": {"type": "string"}, "entries": {"maxItems": 0}, "candidates": {"maxItems": 0}}},
    "else": {"properties": {"unavailable_reason": {"type": "null"}}}
  }],
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"},
    "entry": {
      "type": "object", "additionalProperties": false,
      "required": ["entry_id", "sha256"],
      "properties": {
        "entry_id": {"type": "string", "format": "uuid"},
        "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_id", "kind", "entry_ids", "evidence", "label", "preferred_entry_id", "explanation"],
      "properties": {
        "candidate_id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["exact_duplicate", "same_source", "classification", "preferred"]},
        "entry_ids": {"type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": {"type": "string", "format": "uuid"}},
        "evidence": {"enum": ["full_sha256", "local_visual", "manual", "metadata", "filename"]},
        "label": {"type": ["string", "null"], "minLength": 1, "maxLength": 100},
        "preferred_entry_id": {"type": ["string", "null"], "format": "uuid"},
        "explanation": {"type": "string", "minLength": 1, "maxLength": 500}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "classification"}}}, "then": {"properties": {"label": {"type": "string"}}}, "else": {"properties": {"entry_ids": {"minItems": 2}, "label": {"type": "null"}}}},
        {"if": {"properties": {"kind": {"const": "preferred"}}}, "then": {"properties": {"preferred_entry_id": {"type": "string"}}}, "else": {"properties": {"preferred_entry_id": {"type": "null"}}}},
        {"if": {"properties": {"kind": {"const": "exact_duplicate"}}}, "then": {"properties": {"evidence": {"const": "full_sha256"}}}}
      ]
    }
  }
}
