{
  "name": "@assetlibrary/assetlink",
  "version": "0.1.0",
  "private": true,
  "description": "Generated AssetLink wire models and codecs.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "packageManager": "pnpm@11.19.0",
  "exports": {
    ".": {
      "types": "./dist/generated.d.ts",
      "import": "./dist/generated.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "lint": "tsc --project tsconfig.json --noEmit --pretty false",
    "test": "pnpm run build && node --test test/*.test.mjs",
    "typecheck": "tsc --project tsconfig.json --noEmit --pretty false"
  },
  "devDependencies": {
    "typescript": "6.0.3"
  }
}
