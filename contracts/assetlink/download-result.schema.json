{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://assetlibrary.local/contracts/assetlink/v1/download-result.schema.json",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "message_type",
    "length",
    "start",
    "end",
    "content_sha256",
    "readable",
    "verified"
  ],
  "properties": {
    "message_type": {
      "const": "download.result"
    },
    "length": {
      "$ref": "common.schema.json#/$defs/uint64_decimal"
    },
    "start": {
      "$ref": "common.schema.json#/$defs/uint64_decimal"
    },
    "end": {
      "$ref": "common.schema.json#/$defs/uint64_decimal"
    },
    "content_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "readable": {
      "const": true
    },
    "verified": {
      "const": true
    }
  }
}
