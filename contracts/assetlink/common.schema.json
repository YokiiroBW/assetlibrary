{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://assetlibrary.local/contracts/assetlink/v1/common.schema.json",
  "$defs": {
    "opaque_id": {"type":"string","minLength":1,"maxLength":256,"pattern":"^[A-Za-z0-9._~-]+$"},
    "request_id": {"$ref":"#/$defs/opaque_id"},
    "cursor": {"type":"string","minLength":1,"maxLength":4096},
    "version": {"type":"string","pattern":"^1\\.[0-9]+$"},
    "version_list": {"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/version"}},
    "capabilities": {"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^[a-z][a-z0-9._-]{0,63}$"}},
    "endpoint_role": {"enum":["primary","secondary"]},
    "client": {"type":"object","additionalProperties":false,"required":["kind","version"],"properties":{"kind":{"enum":["web","windows-client","windows-host","android","browser-extension"]},"version":{"type":"string","minLength":1},"device_id":{"$ref":"#/$defs/opaque_id"}}},
    "server_id": {"$ref":"#/$defs/opaque_id"},
    "uint64": {"type":"integer","minimum":0,"maximum":18446744073709551615},
    "sha256": {"type":"string","pattern":"^[A-Fa-f0-9]{64}$"}
  }
}
