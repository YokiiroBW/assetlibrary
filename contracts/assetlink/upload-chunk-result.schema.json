{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://assetlibrary.local/contracts/assetlink/v1/upload-chunk-result.schema.json",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "message_type",
    "transfer_id",
    "offset",
    "accepted",
    "duplicate"
  ],
  "properties": {
    "message_type": {
      "const": "upload.chunk.result"
    },
    "transfer_id": {
      "$ref": "common.schema.json#/$defs/opaque_id"
    },
    "offset": {
      "$ref": "common.schema.json#/$defs/uint64_decimal"
    },
    "accepted": {
      "type": "boolean"
    },
    "duplicate": {
      "type": "boolean"
    }
  }
}
