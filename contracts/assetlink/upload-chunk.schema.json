{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://assetlibrary.local/contracts/assetlink/v1/upload-chunk.schema.json",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "message_type",
    "transfer_id",
    "offset",
    "chunk_size",
    "chunk_sha256"
  ],
  "properties": {
    "message_type": {
      "const": "upload.chunk"
    },
    "transfer_id": {
      "$ref": "common.schema.json#/$defs/opaque_id"
    },
    "offset": {
      "$ref": "common.schema.json#/$defs/uint64"
    },
    "chunk_size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 67108864
    },
    "chunk_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    }
  }
}
