{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://assetlibrary.local/contracts/assetlink/v1/download-range.schema.json",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "message_type",
    "asset_id",
    "start",
    "end"
  ],
  "properties": {
    "message_type": {
      "const": "download.range"
    },
    "asset_id": {
      "$ref": "common.schema.json#/$defs/opaque_id"
    },
    "start": {
      "$ref": "common.schema.json#/$defs/uint64"
    },
    "end": {
      "$ref": "common.schema.json#/$defs/uint64"
    }
  }
}
