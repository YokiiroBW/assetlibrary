{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://assetlibrary.local/contracts/assetlink/v1/error.schema.json",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "message_type",
    "request_id",
    "error"
  ],
  "properties": {
    "message_type": {
      "const": "error"
    },
    "request_id": {
      "$ref": "common.schema.json#/$defs/request_id"
    },
    "error": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{0,63}$",
          "description": "Known codes are open-ended; future codes preserved"
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        },
        "retry_after_ms": {
          "type": "integer",
          "minimum": 1
        },
        "details": {
          "type": "object"
        }
      }
    }
  }
}
