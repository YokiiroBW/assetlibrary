{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://assetlibrary.local/contracts/assetlink/v1/handshake-response.schema.json",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "message_type",
    "selected_version",
    "server_id",
    "server_version",
    "capabilities",
    "endpoint_role"
  ],
  "properties": {
    "message_type": {
      "const": "handshake.response"
    },
    "selected_version": {
      "$ref": "common.schema.json#/$defs/version"
    },
    "server_id": {
      "$ref": "common.schema.json#/$defs/server_id"
    },
    "server_version": {
      "type": "string",
      "minLength": 1
    },
    "capabilities": {
      "$ref": "common.schema.json#/$defs/capabilities"
    },
    "endpoint_role": {
      "$ref": "common.schema.json#/$defs/endpoint_role"
    },
    "request_id": {
      "$ref": "common.schema.json#/$defs/request_id"
    }
  }
}
