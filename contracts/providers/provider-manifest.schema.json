{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://assetlibrary.local/contracts/providers/provider-manifest.schema.json",
  "title": "AssetLibrary Provider Manifest Candidate",
  "description": "M0-008 candidate. This is a wire contract, not an enforcement claim.",
  "type": "object",
  "required": ["manifest_version", "provider_id", "provider_version", "api_versions", "capabilities", "trust_class", "library_scope", "permissions", "resource_limits"],
  "properties": {
    "manifest_version": { "const": "1.0" },
    "provider_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
    "provider_version": { "type": "string", "minLength": 1, "maxLength": 64 },
    "api_versions": { "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": { "type": "string", "pattern": "^[1-9][0-9]*\\.[0-9]+$" } },
    "capabilities": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 128 } },
    "trust_class": { "type": "string", "enum": ["official_signed", "side_loaded", "test_only"] },
    "library_scope": { "type": "array", "maxItems": 128, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 256 } },
    "permissions": {
      "type": "object", "required": ["network", "original_write", "input_tokens_only"],
      "properties": {
        "network": { "type": "boolean", "default": false },
        "approved_network_profile": { "type": ["string", "null"], "maxLength": 128 },
        "original_write": { "const": false },
        "input_tokens_only": { "const": true },
        "filesystem": { "type": "string", "enum": ["supervisor_input_token", "supervisor_temp_only"] }
      }, "additionalProperties": true
    },
    "resource_limits": {
      "type": "object", "required": ["max_request_bytes", "max_response_bytes", "max_artifact_bytes", "request_deadline_ms", "cpu_ms", "memory_bytes", "processes", "file_descriptors"],
      "properties": {
        "max_request_bytes": { "type": "integer", "minimum": 1, "maximum": 1048576 },
        "max_response_bytes": { "type": "integer", "minimum": 1, "maximum": 1048576 },
        "max_artifact_bytes": { "type": "integer", "minimum": 1, "maximum": 67108864 },
        "request_deadline_ms": { "type": "integer", "minimum": 1, "maximum": 300000 },
        "cpu_ms": { "type": "integer", "minimum": 1, "maximum": 300000 },
        "memory_bytes": { "type": "integer", "minimum": 1048576, "maximum": 1073741824 },
        "processes": { "type": "integer", "minimum": 1, "maximum": 4096 },
        "file_descriptors": { "type": "integer", "minimum": 8, "maximum": 4096 }
      }, "additionalProperties": true
    },
    "entrypoint": { "type": "object", "properties": { "executable": { "type": "string", "minLength": 1, "maxLength": 256 }, "arguments": { "type": "array", "maxItems": 32, "items": { "type": "string", "maxLength": 256 } } }, "additionalProperties": true },
    "supported_formats": { "type": "array", "maxItems": 256, "items": { "type": "string", "maxLength": 64 } }
  },
  "additionalProperties": true
}
