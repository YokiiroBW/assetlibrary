{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://assetlibrary.local/contracts/providers/provider-rpc.schema.json",
  "title": "AssetLibrary Provider RPC Candidate",
  "description": "Length-prefixed JSON envelopes. Frame length and artifacts are bounded by the manifest.",
  "oneOf": [
    { "$ref": "#/$defs/discover" }, { "$ref": "#/$defs/handshake" }, { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/result" }, { "$ref": "#/$defs/error" }, { "$ref": "#/$defs/cancel" }, { "$ref": "#/$defs/health" }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "opaque_token": { "type": "string", "pattern": "^(opaque|artifact):[A-Za-z0-9._:-]{1,240}$" },
    "version": { "type": "string", "pattern": "^[1-9][0-9]*\\.[0-9]+$" },
    "common": { "type": "object", "required": ["message_type", "rpc_version", "request_id"], "properties": { "message_type": { "type": "string" }, "rpc_version": { "$ref": "#/$defs/version" }, "request_id": { "$ref": "#/$defs/id" } }, "additionalProperties": true },
    "discover": { "allOf": [{ "$ref": "#/$defs/common" }, { "type": "object", "properties": { "message_type": { "const": "discover" }, "supported_api_versions": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "$ref": "#/$defs/version" } } }, "required": ["supported_api_versions"] }] },
    "handshake": { "allOf": [{ "$ref": "#/$defs/common" }, { "type": "object", "properties": { "message_type": { "const": "handshake" }, "provider_id": { "type": "string" }, "provider_version": { "type": "string" }, "supported_api_versions": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "$ref": "#/$defs/version" } }, "capabilities": { "type": "array", "maxItems": 64, "items": { "type": "string", "maxLength": 128 } }, "permissions": { "type": "object" }, "resource_limits": { "type": "object" } }, "required": ["provider_id", "provider_version", "supported_api_versions", "capabilities", "permissions", "resource_limits"] }] },
    "request": { "allOf": [{ "$ref": "#/$defs/common" }, { "type": "object", "properties": { "message_type": { "const": "request" }, "operation": { "type": "string", "maxLength": 128 }, "input_tokens": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/opaque_token" } }, "deadline_at": { "type": "string", "minLength": 1, "maxLength": 64 }, "max_response_bytes": { "type": "integer", "minimum": 1, "maximum": 1048576 } }, "required": ["operation", "input_tokens", "deadline_at", "max_response_bytes"] }] },
    "result": { "allOf": [{ "$ref": "#/$defs/common" }, { "type": "object", "properties": { "message_type": { "const": "result" }, "status": { "const": "ok" }, "original_write": { "const": false }, "metadata": { "type": "object" }, "suggestions": { "type": "array", "maxItems": 256 }, "artifacts": { "type": "array", "maxItems": 64, "items": { "type": "object", "required": ["artifact_token", "size_bytes", "sha256"], "properties": { "artifact_token": { "$ref": "#/$defs/opaque_token" }, "size_bytes": { "type": "integer", "minimum": 0, "maximum": 67108864 }, "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" } }, "additionalProperties": true } } }, "required": ["status", "original_write"] }] },
    "error": { "allOf": [{ "$ref": "#/$defs/common" }, { "type": "object", "properties": { "message_type": { "const": "error" }, "code": { "type": "string", "maxLength": 128 }, "retryable": { "type": "boolean" }, "detail": { "type": "string", "maxLength": 1024 } }, "required": ["code", "retryable"] }] },
    "cancel": { "allOf": [{ "$ref": "#/$defs/common" }, { "type": "object", "properties": { "message_type": { "const": "cancel" }, "cancel_of": { "$ref": "#/$defs/id" } }, "required": ["cancel_of"] }] },
    "health": { "allOf": [{ "$ref": "#/$defs/common" }, { "type": "object", "properties": { "message_type": { "const": "health" }, "state": { "enum": ["ready", "busy", "degraded", "stopping"] }, "load": { "type": "object" } }, "required": ["state"] }] }
  }
}
