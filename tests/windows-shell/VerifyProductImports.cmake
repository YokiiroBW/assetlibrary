cmake_minimum_required(VERSION 3.20)
if(NOT EXISTS "${PRODUCT_DLL}" OR NOT EXISTS "${LINKER}")
  message(FATAL_ERROR "Product DLL and MSVC linker are required for import inspection.")
endif()
execute_process(COMMAND "${LINKER}" /dump /dependents "${PRODUCT_DLL}"
  RESULT_VARIABLE result OUTPUT_VARIABLE imports ERROR_VARIABLE errors TIMEOUT 10)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Product import inspection failed: ${result} ${errors}")
endif()
string(TOLOWER "${imports}" imports)
string(REGEX MATCHALL "[\r\n][ \t]+[a-z0-9_.-]+\\.dll" dependencies "${imports}")
if(NOT dependencies)
  message(FATAL_ERROR "Import inspection found no DLL dependencies; no pass can be inferred.")
endif()
set(allowed ole32.dll oleaut32.dll shell32.dll user32.dll shlwapi.dll advapi32.dll comctl32.dll kernel32.dll gdi32.dll msimg32.dll oleacc.dll uiautomationcore.dll)
foreach(dependency IN LISTS dependencies)
  string(STRIP "${dependency}" dependency)
  string(TOLOWER "${dependency}" dependency)
  if(NOT dependency IN_LIST allowed)
    message(FATAL_ERROR "Unapproved production DLL dependency: ${dependency}")
  endif()
endforeach()
message(STATUS "Product imports contain only approved Windows system libraries; no dynamic VC CRT, .NET or media/network runtime.")
