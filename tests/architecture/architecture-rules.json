  "module_owners": [
    {
      "module": "GatewayAuth",
      "owns": "authentication context, library authorization orchestration and public entry policies"
    },
    {
      "module": "LibraryStorage",
      "owns": "physical library roots, storage availability and library permission state"
    },
    {
      "module": "AssetIdentity",
      "owns": "asset and folder identity plus observed physical facts"
    },
    {
      "module": "MetadataSidecar",
      "owns": "confirmed metadata, tags, ratings, sidecars and provenance"
    },
    {
      "module": "ScanReconciliation",
      "owns": "read-only discovery, external-change observation and identity reconciliation"
    },
    {
      "module": "TransferSync",
      "owns": "transfer sessions, resumable bytes, synchronization baselines and conflicts"
    },
    {
      "module": "OperationTrash",
      "owns": "physical operation plans, locks, verification, protection and trash"
    },
    {
      "module": "SearchDedup",
      "owns": "search projections, exact duplicate evidence and approved read models"
    },
    {
      "module": "PreviewProvider",
      "owns": "preview requests, derived artifacts and Provider scheduling policy"
    },
    {
      "module": "TaskHealth",
      "owns": "durable tasks, notifications, health and diagnostics state"
    },
    {
      "module": "BackupUpdate",
      "owns": "software backup, restore, update and rollback orchestration"
    }
  ],
