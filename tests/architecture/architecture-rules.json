  "boundary_rules": [
    {
      "id": "adapters-must-not-connect-to-postgresql",
      "roots": ["apps", "gateways", "integrations"],
      "forbidden_tokens": [
        "npgsql",
        "microsoft.entityframeworkcore",
        "org.postgresql",
        "jdbc:postgresql",
        "postgresql://",
        "@prisma/client",
        "from \"pg\"",
        "from 'pg'",
        "require(\"pg\")",
        "require('pg')"
      ]
    },
    {
      "id": "providers-must-not-connect-to-postgresql",
      "roots": ["providers"],
      "forbidden_tokens": [
        "npgsql",
        "microsoft.entityframeworkcore",
        "org.postgresql",
        "jdbc:postgresql",
        "postgresql://",
        "@prisma/client",
        "from \"pg\"",
        "from 'pg'"
      ]
    },
    {
      "id": "shell-must-remain-minimal",
      "roots": ["apps/windows-shell"],
      "forbidden_tokens": [
        "winhttp",
        "wininet",
        "winsock",
        "system.net",
        "curl/",
        "libav",
        "ffmpeg",
        "mediainfo",
        "sqlite",
        "npgsql",
        "entityframeworkcore"
      ]
    },
    {
      "id": "adapters-must-not-duplicate-core-state-machines",
      "roots": ["apps", "gateways", "integrations", "providers"],
      "forbidden_tokens": [
        "class permissionpolicy",
        "class transferstatemachine",
        "class syncstatemachine",
        "class trashpolicy",
        "class operationplanexecutor",
        "class physicalpathpolicy"
      ]
    }
  ],
  "contract_sync": [
